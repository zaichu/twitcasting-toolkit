{
  "name": "TwitCasting Toolkit",
  "short_name": "TwitCasting Tools",
  "description": "TwitCasting の操作を補助するためのツール群です。",
  "version": "2.0.6",
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "alarms",
    "notifications",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://twitcasting.tv/*",
    "https://*.twitcasting.tv/*"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitcasting.tv/*",
        "https://*.twitcasting.tv/*"
      ],
      "run_at": "document_idle",
      "js": [
        "assets/content.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "TwitCasting Toolkit"
  }
}
